# Pigeon environment variables template
# Copy to .env for local overrides (never commit secrets)

# Server
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081

# Database (PostgreSQL)
PIGEON_DB_URL=jdbc:postgresql://localhost:5432/pigeon
PIGEON_DB_USER=pigeon_app
PIGEON_DB_PASSWORD=pigeon_dev_password

# Messaging (RabbitMQ)
PIGEON_RABBIT_HOST=localhost
PIGEON_RABBIT_PORT=5672
PIGEON_RABBIT_USER=guest
PIGEON_RABBIT_PASSWORD=guest

# Cache & Idempotency (Redis)
PIGEON_REDIS_HOST=localhost
PIGEON_REDIS_PORT=6379

# Security (OAuth2 Resource Server)
# Path to PEM public key or raw PEM string
PIGEON_JWT_PUBLIC_KEY=classpath:certs/app.pub

# Simulated Channels
PIGEON_SMTP_HOST=localhost
PIGEON_SMTP_PORT=1025
PIGEON_SMS_BASE_URL=http://localhost:8089/sms
PIGEON_PUSH_BASE_URL=http://localhost:8089/push
PIGEON_WEBHOOK_SECRET=pigeon_dev_webhook_secret_key_32bytes

# High Priority TTL
PIGEON_HIGH_PRIORITY_TTL_MS=60000

# Spring Profiles
SPRING_PROFILES_ACTIVE=local
